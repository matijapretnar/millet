(* functions *)

let f (x: int) = x

let f (x: int) : int = x

let f (x: bool) (y: int) (z: int -> bool -> int) : int = z y x
run f true

let f (x: int) : (int * int) = (x, x)

let 'a. g (x: 'a) = x
let 'a. g (x: 'a) : 'a = 12
let 'a. g (x: 'a) (y: 'a) : 'a = y

(* Parsing of the following two expressions fails.
    Reported error "Syntax error ... Unknown name --b--"
let 'a. g x : 'a * 'b = (x, x)
let 'a. g (x: 'a) (y: 'b) : 'a*'b = (x, y) *)

let 'a. g (x : 'a) : 'a*'a = (x, x)

let f : (int -> int) = function
  | (x: int) -> x

(* variants *)
type ('a,'b) cow = Small of 'a | Large of 'b

let 'a. 'b. f (x : ('a, 'b) cow) : int =
  match x with
  | Small x -> x
  | Large x -> 100

let 'a. 'b. f (x: ('a, 'b) cow) : int =
  match x with
  | Small s -> 100
  | Large (l :int) -> 100

(* records *)
(* Records are not supported.
type ('a,'b) bull = {small : 'a; large : 'b}

let f {small= (x: int); large= (y: int)} = x
*)

(* other *)
let x : int list = ([] : int list)