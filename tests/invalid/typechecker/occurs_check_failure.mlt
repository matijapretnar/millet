(* ----------------------------------------------------------------
   Occurs-check failure: a type can't be made equal to something
   built out of itself. `x` has type `'a list` for a single `'a`,
   so `x :: x` would need `'a = 'a list`.
   Error: "This expression has a type that would require an
   infinite type"
   ---------------------------------------------------------------- *)
run (let x = [] in x :: x)
