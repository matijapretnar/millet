(* The following expression is currently not supported
    ```let a = (let f x = x in (f 5, f "foo")```) because:
    - Expressions of the form ```let a = <expr>, where <expr> is not a pure
        expressions, are not supported.
    - Expressions similar to ```let f x = x in (f 5, f "foo")``` are not
        supported. Type checking fails with error
        "Typing error: Cannot unify int = string".
*)

let 'a. f (x: 'a) = x
run (f 5, f "foo")

let 'a. 'b. g (x: 'a) (y: 'b) = (fun (x: 'a) (y: 'b) -> x) x y

run (g 4 "foo", g "foo" 4)

let 'a. u : 'a list = []

run (1 :: u, "foo" :: u)

let 'a. v : 'a list list = [[]]

run ([] :: v, [2] :: v)

let 'a. weird1 (x: 'a) : 'a =
  let h (t: 'a) (u: 'a) = u in
  h x x
run weird1

let 'a. weird2 (x: 'a) : 'a =
  let h (t: 'a) (u: 'a) = t in
  h x x
run weird2

(*
 * The weird1 and weird2 functions are replacement tests for this behavior
 * since quantified parameters cannot be introduced to lambdas in the run context.
*)
(*
run (fun (x: 'a) -> let h (t: 'b) (u: 'c) = u in h x x)

run (fun (x: 'a) -> let h (t: 'b) (u: 'c) = t in h x x)
*)
let rec 'a. 'b. u (x: 'a) : 'b = u x