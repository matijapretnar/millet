(* ===== Integer arithmetic ===== *)

let square (x: int) : int = x * x
let rectangle_perimeter (a: int) (b: int) : int = 2 * (a + b)
let box_surface (a: int) (b: int) (c: int) : int = 2 * (a * b + a * c + b * c)

run square 7
run rectangle_perimeter 3 4
run box_surface 1 2 3

(* ===== Float arithmetic ===== *)

let celsius_to_fahrenheit (c: float) : float = c *. 1.8 +. 32.0
let fahrenheit_to_celsius (f: float) : float = (f -. 32.0) /. 1.8

run celsius_to_fahrenheit 100.0
run fahrenheit_to_celsius 98.6

(* ===== Conditionals ===== *)

let bmi (weight: float) (height: float) : float = weight /. (height *. height)

let bmi_category (b: float) : string =
  if b < 18.5 then "underweight"
  else if b < 25.0 then "normal"
  else if b < 30.0 then "overweight"
  else "obese"

run bmi_category (bmi 70.0 1.75)
run bmi_category (bmi 50.0 1.75)

(* ===== Tuples ===== *)

let scale (factor: float) ((x, y): (float * float)) : (float * float) = (factor *. x, factor *. y)
let dot ((x1, y1): (float * float)) ((x2, y2): (float * float)) : float = x1 *. x2 +. y1 *. y2
let norm ((x, y): (float * float)) : float = (x *. x +. y *. y) ** 0.5

run scale 2.0 (3.0, 4.0)
run dot (1.0, 0.0) (0.0, 1.0)
run norm (3.0, 4.0)

let hours (s: int) : int = s / 3600
let minutes (s: int) : int = s mod 3600 / 60
let secs (s: int) : int = s mod 60

run (hours 7384, minutes 7384, secs 7384)
