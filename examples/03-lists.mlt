(* ===== Structural recursion on lists ===== *)

let rec sum : (int list -> int) =
  function
  | [] -> 0
  | x :: xs -> x + sum xs

let rec product : (int list -> int) =
  function
  | [] -> 1
  | x :: xs -> x * product xs

run sum [1; 2; 3; 4; 5]        (* 15 *)
run product [1; 2; 3; 4; 5]    (* 120 *)

let rec maximum : (int list -> int) =
  function
  | [x] -> x
  | x :: xs -> max x (maximum xs)

run maximum [3; 1; 4; 1; 5; 9; 2; 6]   (* 9 *)

let rec count (x: int) : (int list -> int) =
  function
  | [] -> 0
  | y :: ys -> (if x = y then 1 else 0) + count x ys

run count 1 [1; 2; 1; 3; 1; 4]    (* 3 *)

(* ===== Standard library list functions ===== *)

run map ((fun x -> x * x) : (int -> int)) [1; 2; 3; 4; 5]               (* [1; 4; 9; 16; 25] *)
run filter ((fun x -> x mod 2 = 0) : (int -> bool)) [1; 2; 3; 4; 5; 6]   (* [2; 4; 6] *)

(* ===== Fold ===== *)

run fold_right ((fun x acc -> x + acc) : (int -> int -> int))  [1; 2; 3; 4; 5] 0
run fold_right ((fun x acc -> x :: acc) : (int -> int list -> int list)) [1; 2; 3] [4; 5]

run fold_left ((fun acc x -> x :: acc) : (int list -> int -> int list)) [] [1; 2; 3; 4; 5]

(* ===== The pipe operator ===== *)

let square (x: int) : int = x * x

run [1; 2; 3; 4; 5]
  |> map square
  |> filter (fun x -> x > 5)
  |> fold_left (fun x y -> x + y) 0

(* ===== Sorting ===== *)

let rec insert_sorted (x: int) : (int list -> int list) =
  function
  | [] -> [x]
  | y :: ys -> if x <= y then x :: y :: ys else y :: insert_sorted x ys

let insertion_sort (xs: int list) : (int list) = fold_left ((fun sorted x -> insert_sorted x sorted) : (int list -> int -> int list)) [] xs

run insertion_sort [5; 3; 8; 1; 9; 2; 4; 7; 6]

(* ===== Association lists ===== *)

let capitals : (string * string) list = [("Scotland", "Edinburgh"); ("Slovenia", "Ljubljana")]

run assoc "Slovenia" capitals
run assoc "Spain" capitals
