(* A small shape-catalog program, showcasing where Millet's
   bidirectional typechecker needs annotations and where it doesn't. *)

type shape =
  | Circle of float
  | Rectangle of float * float
  | Square of float

(* NECESSARY: top-level lambdas have no expected type from outside,
   so every curried parameter needs its own annotation. Match itself
   needs none here -- it inherits `float` from the checked lambda. *)
let area (s: shape) : float =
  match s with
  | Circle r -> 3.14159 *. r *. r
  | Rectangle (w, h) -> w *. h
  | Square side -> side *. side

(* Simple self-recursion: one annotated parameter is enough. *)
let rec total_area (shapes: shape list) : float =
  match shapes with
  | [] -> 0.0
  | s :: rest -> area s +. total_area rest

(* NECESSARY: a recursive call before the last curried
   argument needs the FULL arrow type up front, not just the first
   parameter -- the checker can't discover it mid-body. *)
let rec count_matching (p: shape -> bool) : shape list -> int = function
  | [] -> 0
  | s :: rest -> (if p s then 1 else 0) + count_matching p rest

let is_circle (s: shape) : bool =
  match s with Circle _ -> true | _ -> false

(* UNNECESSARY: `fun s -> ...` needs no annotation -- `count_matching`'s
   own signature already tells the checker its expected type. *)
let count_circles (shapes: shape list) : int =
  count_matching (fun s -> is_circle s) shapes

(* UNNECESSARY: variants never need an annotation on their payload;
   the label's declared type supplies it, just like above. *)
let rec largest (shapes: shape list) : shape option =
  match shapes with
  | [] -> None
  | s :: rest -> (
      match largest rest with
      | None -> Some s
      | Some s' -> if area s >= area s' then Some s else Some s')

let id (x: 'a) : 'a = x

let catalog : shape list =
  [ Circle 2.0; Rectangle (3.0, 4.0); Square 5.0; Circle 1.0 ]

run total_area catalog
run count_circles catalog
run largest catalog
run id 42
run id "hello"

(* NECESSARY: a tuple containing a bare lambda must be CHECKED as a
   whole so its expected type reaches the lambda component -- there
   is no surrounding function signature here to supply one. *)
run (((fun s -> area s), Square 3.0) : (shape -> float) * shape)

