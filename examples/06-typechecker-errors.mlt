(* A catalogue of programs Millet's bidirectional typechecker
   rejects, one per section, each showing the error it produces.

   The checker stops at the first error it hits, so only ONE broken
   block below is active at a time -- everything is commented out.
   Uncomment a single block, run it, read the error, then re-comment
   it before trying the next one. *)

type shape =
  | Circle of float
  | Rectangle of float * float
  | Square of float


(* ----------------------------------------------------------------
   1. Bare lambda, no expected type anywhere to check it against.
   Error: "Cannot infer the type of a function; its argument
   pattern x needs a type annotation ..."
   ---------------------------------------------------------------- *)
(* run (fun x -> x + 1) 5 *)


(* ----------------------------------------------------------------
   2. Same problem, one level deeper: a recursive function with an
   unannotated parameter, whose self-call happens before its type
   could ever be known.
   Error: "Cannot infer the type of a recursive function (bound as
   loop); its argument pattern x needs a type annotation ..."
   ---------------------------------------------------------------- *)
(* run (let rec loop x = loop x in loop 5) *)


(* ----------------------------------------------------------------
   3. A `match` with zero branches and no expected type flowing in
   from a signature or surrounding checked position.
   Error: "Cannot infer the type of a match expression with no
   cases; an annotation is required"
   ---------------------------------------------------------------- *)
(* run (match (1, 2) with) *)


(* ----------------------------------------------------------------
   4. Applying something that isn't a function.
   Error: "This expression of type int is not a function"
   ---------------------------------------------------------------- *)
(* run 5 3 *)


(* ----------------------------------------------------------------
   5. A checking-mode lambda whose expected type isn't an arrow at
   all -- e.g. checked against a plain int.
   Error: "This function is expected to have type int"
   ---------------------------------------------------------------- *)
(* run ((fun x -> x) : int) *)


(* ----------------------------------------------------------------
   6. Same, but for a recursive function -- a full signature that
   isn't an arrow, given via the "f : ty = body" form rather than
   per-parameter annotations.
   Error: "This recursive function is expected to have type int"
   ---------------------------------------------------------------- *)
(* let rec f : int = function | x -> x *)


(* ----------------------------------------------------------------
   7. A plain type mismatch: adding an int to a bool.
   Error: "Cannot unify bool = int"
   ---------------------------------------------------------------- *)
(* run (1 + true) *)


(* ----------------------------------------------------------------
   8. A mismatch between two structurally different types of the
   same arity (a tuple vs. a named type application).
   Error: "Cannot unify int × int = int list"
   ---------------------------------------------------------------- *)
(* let bad : int list = (1, 2) *)


(* ----------------------------------------------------------------
   9. Occurs-check failure: a type can't be made equal to something
   built out of itself. `broken` claims to return 'a but actually
   returns a pair of 'a's.
   Error: "This expression has a type that would require an
   infinite type"
   ---------------------------------------------------------------- *)
(* let broken (x: 'a) : 'a = (x, x) *)


(* ----------------------------------------------------------------
   10. A variant applied to an argument when its label was declared
   to take none.
   Error: "Variant optional argument mismatch"
   ---------------------------------------------------------------- *)
(*
type flag = On | Off
run (On 5)
*)


(* ----------------------------------------------------------------
   11. A tuple pattern whose arity doesn't match its own declared
   type.
   Error: "Expected a tuple pattern of type int × int, got a
   3-tuple"
   ---------------------------------------------------------------- *)
(* let bad ((a, b, c): int * int) : int = a + b + c *)


(* ----------------------------------------------------------------
   12. A named type constructor used with the wrong number of type
   arguments, inside a type definition (arity is currently only
   checked for types appearing in `type ... = ...` definitions, not
   for annotations inside ordinary function signatures -- see the
   file's introductory note above for that caveat).
   Error: "Type list expects 1 arguments but got 2."
   ---------------------------------------------------------------- *)
(* type wrapper = Wrap of (int, bool) list *)
